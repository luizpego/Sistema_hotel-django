DEBUG=true
# Gere uma chave exclusiva antes de publicar. Nunca versione o arquivo .env.
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# sqlite (desenvolvimento) ou postgresql (produção)
DB_ENGINE=sqlite
DB_NAME=hotel
DB_USER=hotel
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Ative apenas se o proxy confiável remover cabeçalhos enviados pelo cliente.
TRUST_PROXY=false
SECURE_SSL_REDIRECT=true
